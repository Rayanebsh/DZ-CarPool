# ===========================
# Django Settings - Production
# ===========================
DEBUG=False
SECRET_KEY=django-very-secure-production-key
ALLOWED_HOSTS=backend,127.0.0.1,localhost,yourdomain.com

# ===========================
# Database
# ===========================
DATABASE_NAME=covoiturage
DATABASE_USER=admin
DATABASE_PASSWORD=secure-db-password
DATABASE_HOST=db
DATABASE_PORT=5432

# ===========================
# CORS
# ===========================
CORS_ALLOWED_ORIGINS=https://yourfrontenddomain.com

# ===========================
# JWT
# ===========================
JWT_SECRET_KEY=jwt-secure-production-key
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ===========================
# Email (pour prod)
# ===========================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-production-email@gmail.com
EMAIL_HOST_PASSWORD=your-production-email-app-password

# ===========================
# Celery
# ===========================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================
# API Externe (prix carburant)
# ===========================
FUEL_PRICES_JSON_PATH=/app/data/prix_carburants.json
